<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Configuración para permitir conexiones HTTPS a tu API -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Confiar en certificados del sistema -->
            <certificates src="system" />
            <!-- Confiar en certificados de usuario (para desarrollo) -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    
    <!-- Configuración específica para tu dominio -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">tester.sivarsocial.com</domain>
        <domain includeSubdomains="true">sivarsocial.com</domain>
    </domain-config>
    
    <!-- Solo para desarrollo local (eliminar en producción) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
