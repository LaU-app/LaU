# Copia lo que necesites a .env.development.local (ignorado por Git).
# Todo VITE_* termina dentro del bundle: aquí solo van valores públicos, nunca secretos.

# API local (opcional). Sin URL absoluta se usa https://api.lauapp.es/api
VITE_API_URL=

# Client ID público de la app Platform de PayPal (el Secret vive solo en el backend)
VITE_PAYPAL_CLIENT_ID=
