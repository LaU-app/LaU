{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "allowJs": true, "checkJs": false, "skipLibCheck": true,
    "noEmit": true, "lib": ["ES2022", "DOM"], "types": ["vite/client"],
    "baseUrl": ".", "paths": { "@/*": ["src/*"] }
  },
  "include": [
    "src/types/marketplace.ts", "src/services/marketplaceService.ts",
    "src/utils/useCart.ts", "src/utils/imageOptimizer.ts", "src/utils/categoryIcon.ts",
    "src/components/marketplace/**/*.vue", "src/components/ImagePickerGrid.vue",
    "src/views/Marketplace*.vue"
  ]
}
